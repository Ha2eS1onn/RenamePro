# 构建输出
bin/
obj/

# 运行产物与打包分发目录（体积大，不入库）
publish/
dist/

# VS 用户文件
*.user

# 运行日志
log.txt

# FFmpeg 二进制与其运行时 DLL 体积过大，不入库
# （exe 来自 build-ffmpeg.ps1 的精简编译，DLL 是同目录必须携带的依赖，见 build-ffmpeg.ps1 注释）
ffmpeg/*.exe
ffmpeg/*.dll
ffmpeg/*.bak

# FFmpeg 载荷：由 publish.ps1 从 ffmpeg\ 生成、编译期嵌入 exe，属构建产物
Assets/ffmpeg-payload.zip
Assets/ffmpeg-payload.zip.hold